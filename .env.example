# Copy to .env and fill in locally. Never commit .env.
# Names only here; values never go in this file.

# Mode and feature flags (Tech Stack §8a): FULLSTAR_MODE=trial|full, flags true|false
FULLSTAR_MODE=
FEATURE_AI_DRAFTS=
FEATURE_AI_CHECK=
# Claude API (only when a FEATURE_AI_* flag is true; trial: leave empty). Model ID default claude-sonnet-5-5
ANTHROPIC_API_KEY=
CLAUDE_MODEL=

# Neon default owner role connection string, used only by make db-bootstrap (Plan 1.2)
NEON_OWNER_URL=

# Written by make db-bootstrap (roles app_owner, app_api, app_system). Migrations use the direct
# host as app_owner; the API uses the pooled host as app_api / app_system.
DB_MIGRATE_JDBC_URL=
DB_JDBC_URL=
DB_APP_OWNER_PASSWORD=
DB_APP_API_PASSWORD=
DB_APP_SYSTEM_PASSWORD=

# Trial endpoints: SeaweedFS (S3 API) and ElasticMQ (SQS API) (Schema trial mode)
# With make up: S3 http://localhost:8333, SQS http://localhost:9324
S3_ENDPOINT=
# Optional: address in signed upload/download URLs for browsers (trial: http://localhost:8080, the
# local Caddy proxies the bucket path to SeaweedFS). Empty = S3_ENDPOINT.
S3_PUBLIC_ENDPOINT=
SQS_ENDPOINT=
# Files: bucket and keys (trial: any long random values; make up configures SeaweedFS with them)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Trial only: make bootstrap creates the bucket
S3_CREATE_BUCKET=
# Queues: credentials (ElasticMQ accepts any) and an optional name prefix
SQS_REGION=
SQS_ACCESS_KEY_ID=
SQS_SECRET_ACCESS_KEY=
QUEUE_PREFIX=

# Verified Brevo sender address for Keycloak SMTP (trial: the project Gmail address)
MAIL_FROM=
# Brevo SMTP (SMTP & API > SMTP): host smtp-relay.brevo.com, port 587, login ...@smtp-brevo.com, SMTP key
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=

# API port on the laptop (default 8081; 8080 is the local Caddy)
API_PORT=

# Privacy notice version parents consent to (default 2026-10-v1); change when the notice changes
CONSENT_VERSION=

# Optional: absolute https link to the privacy notice shown in the apps (empty = none)
PRIVACY_NOTICE_URL=

# Signs parent grants after the PIN (HS256, at least 32 random characters)
PARENT_GRANT_SECRET=
# Optional: Keycloak issuer (default http://localhost:8080/auth/realms/fullstar)
KEYCLOAK_ISSUER_URI=
# Secret of the Keycloak client fullstar-api-admin (staff management, Plan 4.1; at least 32 random
# characters). Read by Keycloak at realm import and by the API; empty in the API = staff management off.
KEYCLOAK_API_ADMIN_SECRET=
# Optional: Keycloak base URL for the admin API (default http://localhost:8080/auth)
KEYCLOAK_ADMIN_URL=

# Optional: Gotenberg for worksheet PDFs (default http://localhost:3000, the make up service), Plan 7.2
GOTENBERG_URL=

# Optional: CPU threads for the reading-checker (faster-whisper; default 2), Plan 8.3
WHISPER_THREADS=

# Hugging Face read token, used only to build the voice-maker image (Plan 8.2): the model
# ai4bharat/indic-parler-tts is gated. Accept its terms first; a fine-grained token needs
# "Read access to contents of all public gated repos". CI reads the repository secret HF_TOKEN.
HF_TOKEN=
# Optional: CPU threads for the voice-maker (default 4), Plan 8.2
VOICE_THREADS=

# Optional: clamd for book-reader (default localhost:3310, the make up ClamAV), Plan 5.2
CLAMAV_HOST=
CLAMAV_PORT=

# Local services (make up). Use long random passwords.
KEYCLOAK_ADMIN_USERNAME=
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_DB_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
# Optional (Plan 9.1): where Grafana emails alerts, through the Brevo SMTP above. Empty = alerts
# show in Grafana only (trial default)
ALERT_EMAIL=
# Optional: API management port for health and Prometheus metrics (default 8091, bound to 127.0.0.1)
MANAGEMENT_PORT=
# Optional (Plan 9.2): browser origins allowed to call the API, comma-separated exact origins
# (default http://localhost:8080; phase G: the family app and Studio origins)
CORS_ALLOWED_ORIGINS=
