# Copy to .env and fill in locally. Never commit .env.
# Names only here; values never go in this file.

# Mode and feature flags (Tech Stack §8a): FULLSTAR_MODE=trial|full, flags true|false
FULLSTAR_MODE=
FEATURE_AI_DRAFTS=
FEATURE_AI_CHECK=

# Neon default owner role connection string, used only by make db-bootstrap (Plan 1.2)
NEON_OWNER_URL=

# Written by make db-bootstrap (roles app_owner, app_api, app_system). Migrations use the direct
# host as app_owner; the API uses the pooled host as app_api / app_system.
DB_MIGRATE_JDBC_URL=
DB_JDBC_URL=
DB_APP_OWNER_PASSWORD=
DB_APP_API_PASSWORD=
DB_APP_SYSTEM_PASSWORD=

# Trial endpoints: SeaweedFS (S3 API) and ElasticMQ (SQS API) (Schema trial mode)
# With make up: S3 http://localhost:8333, SQS http://localhost:9324
S3_ENDPOINT=
SQS_ENDPOINT=

# Verified Brevo sender address for Keycloak SMTP (trial: the project Gmail address)
MAIL_FROM=
# Brevo SMTP (SMTP & API > SMTP): host smtp-relay.brevo.com, port 587, login ...@smtp-brevo.com, SMTP key
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=

# API port on the laptop (default 8081; 8080 is the local Caddy)
API_PORT=

# Local services (make up). Use long random passwords.
KEYCLOAK_ADMIN_USERNAME=
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_DB_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
