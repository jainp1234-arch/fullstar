# Copy to .env and fill in locally. Never commit .env.
# Names only here; values never go in this file.

# Mode and feature flags (Tech Stack §8a): FULLSTAR_MODE=trial|full, flags true|false
FULLSTAR_MODE=
FEATURE_AI_DRAFTS=
FEATURE_AI_CHECK=

# Neon default owner role connection string, used only by infra/db/bootstrap-roles.sql (Plan 1.2)
NEON_OWNER_URL=

# Trial endpoints: SeaweedFS (S3 API) and ElasticMQ (SQS API) (Schema trial mode)
S3_ENDPOINT=
SQS_ENDPOINT=

# Verified Brevo sender address for Keycloak SMTP
MAIL_FROM=
