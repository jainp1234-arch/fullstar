{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "apps",
  "projects": {
    "family-app": {
      "projectType": "application",
      "schematics": {},
      "root": "apps/family-app",
      "sourceRoot": "apps/family-app/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "apps/family-app/src/main.ts",
            "tsConfig": "apps/family-app/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "apps/family-app/public"
              },
              {
                "glob": "**/*.webp",
                "input": "libs/ui/assets/illustrations",
                "output": "ui/illustrations"
              }
            ],
            "styles": ["apps/family-app/src/styles.css"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "serviceWorker": "apps/family-app/ngsw-config.json"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "family-app:build:production"
            },
            "development": {
              "buildTarget": "family-app:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["apps/family-app/**/*.ts", "apps/family-app/**/*.html"],
            "eslintConfig": "apps/family-app/eslint.config.js"
          }
        }
      }
    },
    "content-studio": {
      "projectType": "application",
      "schematics": {},
      "root": "apps/content-studio",
      "sourceRoot": "apps/content-studio/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "apps/content-studio/src/main.ts",
            "tsConfig": "apps/content-studio/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "apps/content-studio/public"
              },
              {
                "glob": "**/*.webp",
                "input": "libs/ui/assets/illustrations",
                "output": "ui/illustrations"
              }
            ],
            "styles": ["apps/content-studio/src/styles.css"],
            "baseHref": "/studio/"
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "content-studio:build:production"
            },
            "development": {
              "buildTarget": "content-studio:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["apps/content-studio/**/*.ts", "apps/content-studio/**/*.html"],
            "eslintConfig": "apps/content-studio/eslint.config.js"
          }
        }
      }
    },
    "ui": {
      "projectType": "library",
      "root": "libs/ui",
      "sourceRoot": "libs/ui",
      "prefix": "app",
      "architect": {
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "libs/ui/tsconfig.spec.json",
            "buildTarget": "family-app:build:development"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["libs/ui/**/*.ts", "libs/ui/**/*.html"],
            "eslintConfig": "libs/ui/eslint.config.js"
          }
        }
      }
    }
  }
}
