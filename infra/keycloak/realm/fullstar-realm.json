{
  "realm": "fullstar",
  "displayName": "FullStar",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "registrationEmailAsUsername": true,
  "rememberMe": false,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "loginTheme": "fullstar",
  "emailTheme": "fullstar",
  "internationalizationEnabled": false,
  "defaultLocale": "en",
  "accessTokenLifespan": 300,
  "accessTokenLifespanForImplicitFlow": 300,
  "accessCodeLifespanLogin": 1800,
  "ssoSessionIdleTimeout": 28800,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 2592000,
  "offlineSessionMaxLifespanEnabled": false,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 10,
  "waitIncrementSeconds": 900,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "smtpServer": {
    "host": "${SMTP_HOST}",
    "port": "${SMTP_PORT}",
    "from": "${MAIL_FROM}",
    "fromDisplayName": "FullStar",
    "auth": "true",
    "authType": "basic",
    "user": "${SMTP_USERNAME}",
    "password": "${SMTP_PASSWORD}",
    "starttls": "true",
    "ssl": "false"
  },
  "roles": {
    "realm": [
      {
        "name": "content_admin",
        "description": "Content Studio: topics, content, checks, publishing, reports, support"
      },
      {
        "name": "super_admin",
        "description": "Content admin plus staff, deletions and audit log"
      }
    ]
  },
  "browserFlow": "fullstar parent browser",
  "authenticationFlows": [
    {
      "id": "5f2c1a8e-0b6d-4c1e-9a51-7a1f3c2d4e01",
      "alias": "fullstar parent browser",
      "description": "Parents: SSO cookie, or email + 6-digit code (account created after the code)",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "autheticatorFlow": true,
          "flowAlias": "fullstar parent forms",
          "userSetupAllowed": false
        }
      ]
    },
    {
      "id": "5f2c1a8e-0b6d-4c1e-9a51-7a1f3c2d4e02",
      "alias": "fullstar parent forms",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "fullstar-email-otp",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "autheticatorFlow": false,
          "userSetupAllowed": false,
          "authenticatorConfig": "fullstar parent email code"
        }
      ]
    },
    {
      "id": "5f2c1a8e-0b6d-4c1e-9a51-7a1f3c2d4e03",
      "alias": "fullstar staff browser",
      "description": "Staff: always email code + TOTP (no SSO cookie, so a parent-style session never skips TOTP)",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticatorFlow": true,
          "requirement": "REQUIRED",
          "priority": 10,
          "autheticatorFlow": true,
          "flowAlias": "fullstar staff forms",
          "userSetupAllowed": false
        }
      ]
    },
    {
      "id": "5f2c1a8e-0b6d-4c1e-9a51-7a1f3c2d4e04",
      "alias": "fullstar staff forms",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "fullstar-email-otp",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "autheticatorFlow": false,
          "userSetupAllowed": false,
          "authenticatorConfig": "fullstar staff email code"
        },
        {
          "authenticator": "auth-otp-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "fullstar parent email code",
      "config": {
        "allowUserCreation": "true"
      }
    },
    {
      "alias": "fullstar staff email code",
      "config": {
        "allowUserCreation": "false"
      }
    }
  ],
  "clients": [
    {
      "clientId": "family-app",
      "name": "Family app",
      "publicClient": true,
      "enabled": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "fullScopeAllowed": false,
      "redirectUris": [
        "http://localhost:8080/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8080/*"
      },
      "defaultClientScopes": [
        "basic",
        "web-origins",
        "acr",
        "email",
        "offline_access"
      ],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "family-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "family-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "content-studio",
      "name": "Content Studio",
      "publicClient": true,
      "enabled": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "fullScopeAllowed": true,
      "redirectUris": [
        "http://localhost:8080/studio/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8080/studio/*",
        "client.session.idle.timeout": "28800",
        "client.session.max.lifespan": "28800"
      },
      "authenticationFlowBindingOverrides": {
        "browser": "5f2c1a8e-0b6d-4c1e-9a51-7a1f3c2d4e03"
      },
      "defaultClientScopes": [
        "basic",
        "web-origins",
        "acr",
        "email",
        "roles"
      ],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "studio-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "studio-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "family-api",
      "name": "Family API (audience)",
      "bearerOnly": true,
      "enabled": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "publicClient": false
    },
    {
      "clientId": "studio-api",
      "name": "Studio API (audience)",
      "bearerOnly": true,
      "enabled": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "publicClient": false
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"email\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false}],\"groups\":[{\"name\":\"user-metadata\",\"displayHeader\":\"User metadata\",\"displayDescription\":\"Attributes, which refer to user metadata\"}],\"unmanagedAttributePolicy\":\"ADMIN_VIEW\"}"
          ]
        }
      }
    ]
  }
}
